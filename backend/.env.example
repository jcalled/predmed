# PREDMED — variáveis de ambiente do backend
# Copie para backend/.env (ignorado pelo git) e preencha. NUNCA versione valores reais.
# O ambiente do processo tem precedência sobre este arquivo.

# Ambiente: "dev" permite padrões de desenvolvimento (segredo gerado localmente,
# senha de demo, CORS localhost). Qualquer outro valor — ou variável ausente —
# é tratado como produção: SECRET_KEY passa a ser obrigatória.
APP_ENV=dev

# Segredo de assinatura do JWT (obrigatório fora de dev, >= 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Origens permitidas no CORS, separadas por vírgula.
# Em dev, vazio = http://localhost:3000,http://127.0.0.1:3000. Fora de dev, vazio = nenhuma.
CORS_ORIGINS=

# Banco de dados (padrão: sqlite:///./predmed.db, relativo a backend/)
DATABASE_URL=

# Senhas dos usuários criados pelo seed (só usadas quando o usuário ainda não existe).
# Fora de dev, usuário sem senha definida não é criado.
SEED_SENHA_PADRAO=
SEED_SENHA_SESA=
SEED_SENHA_SMS=
SEED_SENHA_HGF=
SEED_SENHA_PARTICULAR=
