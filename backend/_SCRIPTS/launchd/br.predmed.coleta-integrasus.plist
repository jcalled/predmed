<plist version="1.0">
<dict>
  <key>Label</key>
  <string>br.predmed.coleta-integrasus</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/juniormarcal/MedOps/predmed-mvp/backend/venv/bin/python</string>
    <string>/Users/juniormarcal/MedOps/predmed-mvp/backend/_SCRIPTS/coleta_fila_integrasus.py</string>
